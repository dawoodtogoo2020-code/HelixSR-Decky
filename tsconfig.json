{
  "compilerOptions": {
    "module": "ESNext", "target": "ES2020", "jsx": "react-jsx",
    "moduleResolution": "node", "esModuleInterop": true, "strict": true,
    "skipLibCheck": true, "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src"], "exclude": ["node_modules"]
}
